---
const tools = [
  { name: 'Java', subtitle: 'JDK', color: 'from-red-500 to-orange-500', icon: '☕' },
  { name: 'Maven', subtitle: 'Build tool', color: 'from-red-400 to-pink-500', icon: '📦' },
  { name: 'Gradle', subtitle: 'Build tool', color: 'from-emerald-400 to-cyan-500', icon: '🐘' },
  { name: 'PHP', subtitle: 'Language', color: 'from-indigo-400 to-purple-500', icon: '🐘' },
  { name: 'Go', subtitle: 'GOROOT', color: 'from-cyan-400 to-blue-500', icon: '🐹' },
  { name: 'Node.js', subtitle: 'Runtime', color: 'from-green-400 to-emerald-500', icon: '🟢' },
];
---

<section id="herramientas" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-50"
    aria-hidden="true"
  >
    <div
      class="absolute top-0 left-1/2 h-[600px] w-[1000px] -translate-x-1/2 rounded-full bg-cyan-500/5 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-cyan-400">
        Soportado
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-5xl">
        Un CLI para gobernarlos a todos
      </p>
      <p class="mt-6 text-lg leading-8 text-slate-300">
        Java, Maven, Gradle, PHP, Go y Node.js. Descargá, instalá y cambiá de
        versión sin salir de la terminal.
      </p>
    </div>

    <div class="mx-auto mt-20 grid max-w-5xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => (
          <div class="group relative overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 p-7 text-center transition duration-300 hover:-translate-y-1 hover:border-slate-600 hover:bg-slate-800/60 hover:shadow-2xl hover:shadow-cyan-500/5">
            <div
              class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${tool.color}`}
            />
            <div
              class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-slate-800 text-3xl shadow-inner transition duration-300 group-hover:scale-110"
            >
              {tool.icon}
            </div>
            <h3 class="text-2xl font-bold text-white">{tool.name}</h3>
            <p class="mt-1 text-sm font-medium text-slate-400">
              {tool.subtitle}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
