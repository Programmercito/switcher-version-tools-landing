---
const links = [
  { label: 'Características', href: '#caracteristicas' },
  { label: 'Herramientas', href: '#herramientas' },
  { label: 'Instalar', href: '#instalar' },
  { label: 'Uso', href: '#uso' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/80 backdrop-blur-md">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
    aria-label="Global"
  >
    <a href="#" class="flex items-center gap-2 text-lg font-bold text-white">
      <span class="gradient-text">switchtool</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 transition hover:text-emerald-400"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <a
      href="https://github.com/Programmercito/switcher-version-tools"
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-lg border border-slate-700 bg-slate-900/50 px-4 py-2 text-sm font-medium text-white transition hover:border-emerald-500/50 hover:bg-slate-800"
    >
      GitHub
    </a>
  </nav>
</header>
