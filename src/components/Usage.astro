---
const examples = [
  {
    title: 'Instalar desde una URL',
    description: 'Descargá un JDK de Adoptium y dejalo listo para usar. switchtool baja, extrae y configura todo.',
    command:
      'switchtool java jdk17 https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.9%2B9/OpenJDK17U-jdk_x64_windows_hotspot_17.0.9_9.zip',
  },
  {
    title: 'Usar un archivo local',
    description: 'También podés instalar desde un .zip que ya tengas en disco. Solo pasale el path.',
    command: 'switchtool php 8.2 C:\\Downloads\\php-8.2.10-Win32-vs16-x64.zip',
  },
  {
    title: 'Cambiar de versión',
    description: 'Una vez instalado, el cambio es inmediato. Actualiza el PATH y las variables de entorno.',
    command: 'switchtool jdk17\nswitchtool php8.2',
  },
  {
    title: 'Listar instalaciones',
    description: 'Vé qué versiones tenés y cuál está activa en este momento.',
    command: 'switchtool list\n# o\nswitchtool ls',
  },
  {
    title: 'Eliminar un alias',
    description: 'Borra una versión del registro y del disco cuando ya no la necesites.',
    command: 'switchtool remove jdk17',
  },
];
---

<section id="uso" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute bottom-0 right-0 h-[600px] w-[600px] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute top-0 left-0 h-[500px] w-[500px] rounded-full bg-emerald-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-cyan-400">Uso</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-5xl">
        Comandos que vas a usar todo el tiempo
      </p>
      <p class="mt-6 text-lg leading-8 text-slate-300">
        La sintaxis es simple: primero tipo, alias y origen. Después, solo el
        alias para cambiar.
      </p>
    </div>

    <div class="mx-auto mt-20 grid max-w-5xl gap-6">
      {
        examples.map((example, index) => (
          <div class="group rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition duration-300 hover:border-slate-600 hover:bg-slate-800/50 lg:p-8">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="lg:max-w-xs">
                <div class="mb-3 flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-cyan-500 to-emerald-500 text-sm font-bold text-slate-950">
                  {index + 1}
                </div>
                <h3 class="text-xl font-bold text-white">{example.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">
                  {example.description}
                </p>
              </div>
              <div class="relative flex-1 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
                <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2.5">
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                    PowerShell
                  </span>
                  <button
                    type="button"
                    class="copy-btn flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1 text-xs font-semibold text-cyan-400 transition hover:bg-slate-800 hover:text-cyan-300"
                    data-code={example.command}
                  >
                    <svg
                      class="h-3.5 w-3.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                      />
                    </svg>
                    Copiar
                  </button>
                </div>
                <pre class="code-block overflow-x-auto p-4 text-sm leading-relaxed text-cyan-300">
                  <code>{example.command}</code>
                </pre>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = button.dataset.code || '';
        await navigator.clipboard.writeText(code);
        const original = button.innerHTML;
        button.innerHTML = '<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copiado';
        setTimeout(() => {
          button.innerHTML = original;
        }, 2000);
      });
    });
  </script>
</section>
