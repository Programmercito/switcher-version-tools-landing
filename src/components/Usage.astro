---
const examples = [
  {
    title: 'Instalar desde una URL',
    description: 'Descargá un JDK de Adoptium y dejalo listo para usar.',
    command:
      'switchtool java jdk17 https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.9%2B9/OpenJDK17U-jdk_x64_windows_hotspot_17.0.9_9.zip',
  },
  {
    title: 'Usar un archivo local',
    description: 'También podés instalar desde un .zip que ya tengas en disco.',
    command: 'switchtool php 8.2 C:\\Downloads\\php-8.2.10-Win32-vs16-x64.zip',
  },
  {
    title: 'Cambiar de versión',
    description: 'Una vez instalado, el cambio es inmediato.',
    command: 'switchtool jdk17\nswitchtool php8.2',
  },
  {
    title: 'Listar instalaciones',
    description: 'Vé qué versiones tenés y cuál está activa.',
    command: 'switchtool list\n# o\nswitchtool ls',
  },
  {
    title: 'Eliminar un alias',
    description: 'Borra una versión del registro y del disco.',
    command: 'switchtool remove jdk17',
  },
];
---

<section id="uso" class="relative py-20 lg:py-28">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute bottom-0 right-0 h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-cyan-400">
        Uso
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Comandos que vas a usar todo el tiempo
      </p>
      <p class="mt-6 text-lg leading-8 text-slate-300">
        La sintaxis es simple: tipo, alias y origen. Después, solo el alias.
      </p>
    </div>

    <div class="mx-auto mt-16 grid max-w-4xl gap-6">
      {
        examples.map((example) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 lg:p-8">
            <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
              <div class="lg:max-w-xs">
                <h3 class="text-lg font-semibold text-white">
                  {example.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-400">
                  {example.description}
                </p>
              </div>
              <div class="relative flex-1 overflow-hidden rounded-xl bg-slate-950 ring-1 ring-slate-800">
                <pre class="code-block overflow-x-auto p-4 text-sm leading-relaxed text-cyan-300">
                  <code>{example.command}</code>
                </pre>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
