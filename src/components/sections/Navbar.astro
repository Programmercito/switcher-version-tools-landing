---
const links = [
  { label: 'Cómo funciona', href: '#como-funciona' },
  { label: 'Herramientas', href: '#herramientas' },
  { label: 'Instalar', href: '#instalar' },
  { label: 'Compilar', href: '#compilar' },
  { label: 'Uso', href: '#uso' },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-slate-950/70 backdrop-blur-xl"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8"
    aria-label="Global"
  >
    <a href="#" class="group flex items-center gap-2.5 text-lg font-bold text-white" aria-label="switchtool, inicio">
      <span class="relative flex h-9 w-9 items-center justify-center rounded-xl border border-emerald-400/40 bg-slate-900 shadow-lg shadow-emerald-500/10 transition group-hover:rotate-6 group-hover:border-cyan-300/70">
        <span class="absolute inset-1 rounded-lg bg-gradient-to-br from-emerald-400 to-cyan-400 opacity-20"></span>
        <svg class="relative h-5 w-5 text-emerald-300" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 7.5 12 4l7 3.5v7L12 18l-7-3.5v-7Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
          <path d="m5 7.5 7 4 7-4M12 11.5V18" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="tracking-tight"><span class="text-white">switch</span><span class="gradient-text">tool</span></span>
    </a>

    <!-- desktop links -->
    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="group relative text-sm font-semibold text-slate-300 transition hover:text-white"
          >
            {link.label}
            <span class="absolute -bottom-1 left-0 h-0.5 w-0 bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-300 group-hover:w-full" />
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/Programmercito/switcher-version-tools"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden rounded-xl border border-slate-700 bg-slate-900/60 px-4 py-2 text-sm font-bold text-white transition hover:border-emerald-500/50 hover:bg-slate-800 md:inline-flex"
      >
        GitHub
      </a>

      <!-- mobile menu button -->
      <button
        type="button"
        class="mobile-menu-btn inline-flex items-center justify-center rounded-xl border border-slate-700 bg-slate-900/60 p-2 text-white md:hidden"
        aria-label="Abrir menú"
      >
        <svg class="h-6 w-6 menu-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="menu-close hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- mobile menu -->
  <div class="mobile-menu hidden border-t border-slate-800 bg-slate-950/95 px-6 pb-6 pt-2 md:hidden">
    <div class="flex flex-col gap-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-4 py-3 text-base font-semibold text-slate-300 transition hover:bg-slate-800 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://github.com/Programmercito/switcher-version-tools"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/60 px-4 py-3 text-base font-bold text-white transition hover:border-emerald-500/50 hover:bg-slate-800"
      >
        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path>
        </svg>
        GitHub
      </a>
    </div>
  </div>

  <script>
    document.querySelectorAll('.mobile-menu-btn').forEach((button) => {
      button.addEventListener('click', () => {
        const menu = document.querySelector('.mobile-menu');
        const openIcon = button.querySelector('.menu-open');
        const closeIcon = button.querySelector('.menu-close');
        if (menu) {
          menu.classList.toggle('hidden');
        }
        openIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
        const isOpen = !menu?.classList.contains('hidden');
        button.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
        button.setAttribute('aria-expanded', String(isOpen));
      });
    });

    document.querySelectorAll('.mobile-menu a').forEach((link) => {
      link.addEventListener('click', () => {
        const menu = document.querySelector('.mobile-menu');
        const button = document.querySelector('.mobile-menu-btn');
        const openIcon = button?.querySelector('.menu-open');
        const closeIcon = button?.querySelector('.menu-close');
        menu?.classList.add('hidden');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
        button?.setAttribute('aria-label', 'Abrir menú');
        button?.setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</header>
