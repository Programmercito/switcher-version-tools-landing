---
import TerminalWindow from '../ui/TerminalWindow.astro';

const githubUrl = 'https://github.com/Programmercito/switcher-version-tools';
const releaseUrl = `${githubUrl}/releases`;
---

<section class="relative overflow-hidden pt-16 pb-8 sm:pt-20 sm:pb-10 lg:pt-24 lg:pb-12">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-70"
    aria-hidden="true"
  >
    <div
      class="animated-gradient absolute -top-1/3 -right-1/4 h-[800px] w-[800px] rounded-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-emerald-500/20 via-cyan-500/10 to-transparent blur-3xl"
    >
    </div>
    <div
      class="animated-gradient absolute top-1/4 -left-1/4 h-[700px] w-[700px] rounded-full bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-cyan-500/15 via-emerald-500/5 to-transparent blur-3xl"
      style="animation-delay: -4s;"
    >
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.03]"
    style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 60px 60px;"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <div
        class="mb-4 inline-flex max-w-full items-center gap-2 rounded-full border border-emerald-500/30 bg-gradient-to-r from-emerald-500/15 to-cyan-500/15 px-3 py-1.5 text-center text-xs font-semibold text-emerald-300 shadow-lg shadow-emerald-500/10 sm:mb-6 sm:px-5 sm:py-2 sm:text-sm"
      >
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400"
          ></span>
        </span>
        CLI para desarrolladores en Windows
      </div>

      <h1 class="text-3xl font-extrabold leading-[1.05] tracking-tight sm:text-4xl md:text-6xl lg:text-7xl">
        <span class="block text-white">Gestioná tus</span>
        <span class="gradient-text">versiones</span>
        <span class="block text-white">como un profesional</span>
      </h1>

      <p
        class="mx-auto mt-4 max-w-2xl text-sm leading-6 text-slate-300 sm:mt-5 sm:text-base sm:leading-7 md:text-lg"
      >
        <strong class="text-emerald-400">switchtool</strong> es un CLI en Go que
        te permite instalar, cambiar y administrar versiones de{' '}
        <span class="text-white">Java, Maven, Gradle, PHP, Go y Node.js</span>{' '}
        en Windows sin tocar el PATH a mano. Descargá, extraé y configurá todo
        con un solo comando.
      </p>

      <div
        class="mt-5 flex flex-col items-stretch justify-center gap-2 sm:mt-6 sm:flex-row sm:items-center sm:gap-4"
      >
        <a
          href={releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/25 transition hover:scale-105 hover:shadow-emerald-500/40 sm:px-8 sm:text-base"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"></path>
          </svg>
          Descargar binario
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/60 px-5 py-3 text-sm font-bold text-slate-200 backdrop-blur transition hover:border-slate-500 hover:bg-slate-800 hover:text-white sm:px-8 sm:text-base"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          Ver en GitHub
        </a>
      </div>

      <p class="mt-3 text-xs text-slate-500 sm:text-sm">
        ¿Preferís el paso a paso? Mirá la{' '}
        <a
          href="#instalar"
          class="underline hover:text-emerald-400">guía de instalación</a
        >
      </p>
    </div>

    <TerminalWindow class="mt-8 sm:mt-12">
      <div class="flex items-start gap-2">
        <span class="select-none text-emerald-500">➜</span>
        <span class="font-medium text-slate-100"
          >switchtool java jdk17 https://.../jdk17.zip</span
        >
      </div>
      <div class="pl-6 text-emerald-400">✓ Descarga completada</div>
      <div class="pl-6 text-emerald-400">✓ Descompresión completada</div>
      <div class="pl-6 text-slate-400">
        Directorio principal detectado: C:\Users\dev\.switchtool\jdk17
      </div>
      <div class="pl-6 text-emerald-400">
        ✓ Alias jdk17 agregado a la configuración.
      </div>
      <div class="flex items-start gap-2">
        <span class="select-none text-emerald-500">➜</span>
        <span class="font-medium text-slate-100">switchtool jdk17</span>
      </div>
      <div class="pl-6 text-emerald-400">
        Listo: ahora se está usando 'jdk17' para java.
      </div>
      <div class="mt-3 flex items-start gap-2">
        <span class="select-none text-emerald-500">➜</span>
        <span class="inline-block h-5 w-2 animate-pulse rounded-sm bg-emerald-400"
        ></span>
      </div>
    </TerminalWindow>
  </div>
</section>
