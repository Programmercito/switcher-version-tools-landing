---
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';
import CodeBlock from '../ui/CodeBlock.astro';

const releaseUrl = 'https://github.com/Programmercito/switcher-version-tools/releases';

const addToPathCommand = `$dir = "C:\\Tools"
$path = [Environment]::GetEnvironmentVariable("Path", "User")
[Environment]::SetEnvironmentVariable("Path", "$path;$dir", "User")`;

const verifyCommand = 'switchtool --version';
---

<section id="instalar" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute bottom-0 left-0 h-[600px] w-[600px] rounded-full bg-emerald-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute top-0 right-0 h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      eyebrow="Instalación"
      title="Instalalo en 4 pasos"
      description="Sin instaladores ni dependencias: un solo .exe y cuatro pasos."
    />

    <div class="mx-auto mt-20 max-w-3xl">
      <ol class="steps space-y-6">
        <!-- Paso 1 -->
        <li class="relative pl-14 sm:pl-16">
          <span
            class="absolute left-0 top-7 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-cyan-500 text-base font-extrabold text-white shadow-lg shadow-emerald-500/30 ring-4 ring-slate-950"
            >1</span
          >
          <Card glow>
            <div class="p-7 sm:p-8">
              <h3 class="text-xl font-bold text-white">
                Descargá el binario
              </h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Bajá{' '}
                <code class="text-emerald-300">switchtool.exe</code>{' '}
                desde GitHub Releases. Es un único archivo: no necesita
                instalación.
              </p>
              <a
                href={releaseUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 px-6 py-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/25 transition hover:scale-[1.03] hover:shadow-emerald-500/40"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                  ></path>
                </svg>
                Ir a Releases
              </a>
            </div>
          </Card>
        </li>

        <!-- Paso 2 -->
        <li class="relative pl-14 sm:pl-16">
          <span
            class="absolute left-0 top-7 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-cyan-500 text-base font-extrabold text-white shadow-lg shadow-emerald-500/30 ring-4 ring-slate-950"
            >2</span
          >
          <Card glow>
            <div class="p-7 sm:p-8">
              <h3 class="text-xl font-bold text-white">
                Elegí una ubicación fija
              </h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Guardá el{' '}
                <code class="text-emerald-300">.exe</code>{' '}
                en una carpeta duradera, por ejemplo{' '}
                <code class="text-emerald-300">C:\Tools</code>{' '}
                (evitá Descargas o Escritorio).
              </p>
            </div>
          </Card>
        </li>

        <!-- Paso 3 -->
        <li class="relative pl-14 sm:pl-16">
          <span
            class="absolute left-0 top-7 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-cyan-500 text-base font-extrabold text-white shadow-lg shadow-emerald-500/30 ring-4 ring-slate-950"
            >3</span
          >
          <Card glow>
            <div class="p-7 sm:p-8">
              <h3 class="text-xl font-bold text-white">
                Agregá la carpeta al PATH
              </h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Corré esto en PowerShell (ajustá{' '}
                <code class="text-emerald-300">$dir</code>{' '}
                si usaste otra carpeta), o hacelo desde Configuración →
                Editar variables de entorno del sistema.
              </p>
              <div class="mt-6">
                <CodeBlock code={addToPathCommand} label="PowerShell" />
              </div>
            </div>
          </Card>
        </li>

        <!-- Paso 4 -->
        <li class="relative pl-14 sm:pl-16">
          <span
            class="absolute left-0 top-7 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-emerald-500 to-cyan-500 text-base font-extrabold text-white shadow-lg shadow-emerald-500/30 ring-4 ring-slate-950"
            >4</span
          >
          <Card glow>
            <div class="p-7 sm:p-8">
              <h3 class="text-xl font-bold text-white">
                Reabrí la terminal y verificá
              </h3>
              <p class="mt-3 leading-relaxed text-slate-400">
                Los cambios de PATH se aplican en las sesiones nuevas. Abrí
                una terminal y probá:
              </p>
              <div class="mt-6">
                <CodeBlock code={verifyCommand} label="Terminal" />
              </div>
            </div>
          </Card>
        </li>
      </ol>

      <div
        class="mt-14 rounded-2xl border border-cyan-500/20 bg-gradient-to-br from-cyan-500/10 to-emerald-500/5 p-8"
      >
        <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
          <div class="rounded-2xl bg-cyan-500/10 p-3 text-cyan-400">
            <svg
              class="h-8 w-8"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <div>
            <h4 class="text-lg font-bold text-white">
              Y listo: se acabó el{' '}
              <code class="text-cyan-300">.\switchtool.exe</code>
            </h4>
            <p class="mt-2 text-slate-300">
              Con la carpeta en el PATH, escribís solo{' '}
              <code class="rounded-lg bg-slate-950 px-2 py-1 text-emerald-300">switchtool</code>{' '}
              desde cualquier directorio. Si la terminal no lo encuentra,
              reabrila: es el paso que más se olvida.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
  }
  .steps li::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 4.25rem;
    bottom: -3.5rem;
    width: 2px;
    background: linear-gradient(
      to bottom,
      rgb(16 185 129 / 0.5),
      rgb(6 182 212 / 0.35)
    );
  }
  .steps li:last-child::before {
    display: none;
  }
</style>
