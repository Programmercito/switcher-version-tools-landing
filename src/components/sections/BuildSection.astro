---
import SectionHeader from '../ui/SectionHeader.astro';
import CodeBlock from '../ui/CodeBlock.astro';
import GradientBadge from '../ui/GradientBadge.astro';

const compileCommand = `git clone https://github.com/Programmercito/switcher-version-tools.git
cd switcher-version-tools
go build -o switchtool.exe .`;
---

<section id="compilar" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/2 left-1/2 h-[600px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      eyebrow="Para desarrolladores"
      title="Compilá desde el código fuente"
      description="Si querés la última versión o querés contribuir, cloná el repo y compilalo con Go."
      eyebrowColor="cyan"
    />

    <div class="mx-auto mt-16 max-w-3xl">
      <div
        class="rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-8 shadow-2xl shadow-cyan-500/5 lg:p-10"
      >
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h3 class="text-2xl font-bold text-white">Build manual</h3>
            <p class="mt-2 text-slate-400">
              Requiere Go 1.24.2 o posterior instalado en tu sistema.
            </p>
          </div>
          <GradientBadge
            text="Go 1.24.2+"
            gradient="from-cyan-600 to-blue-600"
          />
        </div>

        <CodeBlock code={compileCommand} label="Terminal" variant="cyan" align="left" />

        <a
          href="https://github.com/Programmercito/switcher-version-tools"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-cyan-400 transition hover:text-cyan-300"
        >
          Ver el repositorio en GitHub
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
