---
import SectionHeader from '../ui/SectionHeader.astro';
import Card from '../ui/Card.astro';

const features = [
  {
    title: 'Descarga automática',
    description:
      'Instalá desde una URL o un archivo local .zip, .tar.gz o .tgz. Las descargas muestran progreso y reintentan errores transitorios.',
    icon: 'download',
    gradient: 'from-emerald-400 to-cyan-400',
  },
  {
    title: 'PATH inteligente',
    description:
      'Olvidate de editar variables de entorno a mano. Limpiá y actualizá el PATH de usuario con PowerShell automáticamente.',
    icon: 'path',
    gradient: 'from-cyan-400 to-blue-500',
  },
  {
    title: 'Variables de entorno',
    description:
      'Configurá JAVA_HOME, MAVEN_HOME, GRADLE_HOME, PHP_HOME, GOROOT, NODE_HOME y PNPM_HOME en el entorno de usuario.',
    icon: 'env',
    gradient: 'from-emerald-500 to-teal-400',
  },
  {
    title: 'Detección de raíz',
    description:
      '¿El ZIP tiene una carpeta intermedia? switchtool la detecta y entra solito, así no tenés que mover archivos.',
    icon: 'folder',
    gradient: 'from-teal-400 to-cyan-500',
  },
  {
    title: 'Cambio en un comando',
    description:
      'Pasá de Java 17 a Java 21, o de Node 18 a Node 20, con un único comando: switchtool jdk21.',
    icon: 'switch',
    gradient: 'from-green-400 to-emerald-500',
  },
  {
    title: 'UI amigable',
    description:
      'Colores, barra de progreso, spinners y mensajes claros para que instalar y cambiar versiones sea una experiencia piola.',
    icon: 'ui',
    gradient: 'from-cyan-500 to-indigo-400',
  },
  {
    title: 'Diagnóstico del entorno',
    description:
      'Con switchtool doctor detectá instalaciones ausentes, variables incorrectas y conflictos con el PATH de la terminal.',
    icon: 'diagnostic',
    gradient: 'from-amber-400 to-emerald-400',
  },
  {
    title: 'Versiones por proyecto',
    description:
      'Definí los alias de un proyecto en switchtool.json y activalos explícitamente con switchtool project use.',
    icon: 'project',
    gradient: 'from-blue-400 to-cyan-400',
  },
  {
    title: 'Listas para scripts',
    description:
      'Consultá la versión real detectada y exportá tus instalaciones como JSON o como una lista de alias.',
    icon: 'list',
    gradient: 'from-violet-400 to-cyan-400',
  },
];

const icons: Record<string, string> = {
  download:
    'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4',
  path: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  env: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  folder:
    'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  switch: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  ui: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
  diagnostic: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  project: 'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  list: 'M9 5h11M9 12h11M9 19h11M4 5h.01M4 12h.01M4 19h.01',
};
---

<section id="como-funciona" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-50"
    aria-hidden="true"
  >
    <div
      class="absolute top-1/2 left-1/2 h-[700px] w-[900px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/5 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <SectionHeader
      eyebrow="¿Cómo funciona?"
      title="Todo lo aburrido, automatizado"
      description="switchtool hace el trabajo pesado para que vos solo te preocupes por codear."
    />

    <div
      class="mx-auto mt-20 grid max-w-7xl gap-6 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        features.map((feature) => (
          <Card glow class="group relative overflow-hidden p-8">
            <div
              class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${feature.gradient}`}
            />
            <div
              class={`mb-6 inline-flex rounded-2xl bg-gradient-to-br ${feature.gradient} p-3.5 text-slate-950 shadow-lg transition duration-300 group-hover:scale-110 group-hover:shadow-xl`}
            >
              <svg
                class="h-7 w-7"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={icons[feature.icon]}
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white">{feature.title}</h3>
            <p class="mt-3 leading-relaxed text-slate-400">
              {feature.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
