---
interface Props {
  title?: string;
  class?: string;
}

const { title = 'switchtool.exe', class: className = '' } = Astro.props;
---

<div
  class={`glow-green mx-auto max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 shadow-2xl ${className}`}
>
  <div
    class="flex items-center justify-between border-b border-slate-800 bg-gradient-to-r from-slate-900 to-slate-800 px-5 py-3"
  >
    <div class="flex items-center gap-2">
      <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
      <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
      <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
    </div>
    <span class="text-xs font-medium text-slate-500">{title}</span>
  </div>
  <div class="code-block space-y-1.5 p-6 text-sm leading-relaxed">
    <slot />
  </div>
</div>
