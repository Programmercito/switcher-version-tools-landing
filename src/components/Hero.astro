---
const githubUrl = 'https://github.com/Programmercito/switcher-version-tools';
const releaseUrl = `${githubUrl}/releases`;
---

<section class="relative overflow-hidden pt-24 pb-20 lg:pt-32 lg:pb-28">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-60"
    aria-hidden="true"
  >
    <div
      class="absolute -top-1/4 -right-1/4 h-[600px] w-[600px] rounded-full bg-emerald-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute top-1/3 -left-1/4 h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-4 py-1.5 text-sm font-medium text-emerald-300"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
          ></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"
          ></span>
        </span>
        CLI para desarrolladores en Windows
      </div>

      <h1 class="text-5xl font-extrabold tracking-tight sm:text-7xl">
        <span class="block text-white">Domina tus</span>
        <span class="gradient-text">versiones</span>
        <span class="block text-white">sin tocar el PATH</span>
      </h1>

      <p
        class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-slate-300 sm:text-xl"
      >
        <strong class="text-emerald-400">switchtool</strong> es un CLI en Go que
        descarga, extrae y configura automáticamente Java, Maven, Gradle, PHP,
        Go y Node.js en Windows. Cambiá de versión con un solo comando.
      </p>

      <div
        class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
      >
        <a
          href="#instalar"
          class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 px-8 py-4 text-base font-semibold text-white shadow-lg shadow-emerald-500/20 transition hover:scale-105 hover:shadow-emerald-500/30 focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:ring-offset-2 focus:ring-offset-slate-950"
        >
          Instalar con Chocolatey
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-700 bg-slate-900/50 px-8 py-4 text-base font-semibold text-slate-200 backdrop-blur transition hover:border-slate-500 hover:bg-slate-800 hover:text-white"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
            ></path>
          </svg>
          Ver en GitHub
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        También disponible en <a
          href={releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="underline hover:text-emerald-400">Releases</a
        >
      </p>
    </div>
  </div>
</section>
