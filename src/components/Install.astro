---
const methods = [
  {
    title: 'Chocolatey',
    command: 'choco install switchtool',
    description:
      'La forma más rápida. Si ya tenés Chocolatey, en unos segundos tenés switchtool en el PATH listo para usar.',
    badge: 'Recomendado',
    gradient: 'from-emerald-500 to-cyan-500',
  },
  {
    title: 'Binario',
    command: '# Descargá switchtool.exe desde Releases y agregalo a tu PATH',
    description:
      'Ideal si no usás Chocolatey. Bajás el .exe, lo guardás en una carpeta y la agregás al PATH de Windows.',
    badge: 'Manual',
    gradient: 'from-slate-600 to-slate-500',
  },
  {
    title: 'Compilar',
    command: 'git clone https://github.com/Programmercito/switcher-version-tools.git\ncd switcher-version-tools\ngo build -o switchtool.exe .',
    description: 'Para quienes quieren toquetear el código o usar la última versión del repo.',
    badge: 'Go 1.24+',
    gradient: 'from-cyan-600 to-blue-600',
  },
];
---

<section id="instalar" class="relative py-24 lg:py-32">
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    aria-hidden="true"
  >
    <div
      class="absolute bottom-0 left-0 h-[600px] w-[600px] rounded-full bg-emerald-500/10 blur-3xl"
    >
    </div>
    <div
      class="absolute top-0 right-0 h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-3xl"
    >
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-emerald-400">
        Instalación
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-5xl">
        Elegí cómo empezar
      </p>
      <p class="mt-6 text-lg leading-8 text-slate-300">
        La recomendada es Chocolatey, pero también podés bajar el binario o
        compilarlo vos mismo.
      </p>
    </div>

    <div class="mx-auto mt-20 grid max-w-6xl gap-8 lg:grid-cols-3">
      {
        methods.map((method) => (
          <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 transition duration-300 hover:-translate-y-1 hover:border-slate-600 hover:shadow-2xl hover:shadow-emerald-500/5">
            <div class={`h-1.5 w-full bg-gradient-to-r ${method.gradient}`} />
            <div class="flex flex-1 flex-col p-7">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-bold text-white">{method.title}</h3>
                <span
                  class={`rounded-full bg-gradient-to-r ${method.gradient} px-3 py-1 text-xs font-bold text-white shadow-lg`}
                >
                  {method.badge}
                </span>
              </div>
              <p class="mt-4 flex-1 leading-relaxed text-slate-400">
                {method.description}
              </p>

              <div class="relative mt-8 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
                <div class="flex items-center justify-between border-b border-slate-800 px-4 py-2.5">
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Terminal
                  </span>
                  <button
                    type="button"
                    class="copy-btn flex items-center gap-1.5 rounded-md bg-slate-900 px-3 py-1 text-xs font-semibold text-emerald-400 transition hover:bg-slate-800 hover:text-emerald-300"
                    data-code={method.command}
                  >
                    <svg
                      class="h-3.5 w-3.5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
                      />
                    </svg>
                    Copiar
                  </button>
                </div>
                <pre class="code-block overflow-x-auto p-4 text-sm leading-relaxed text-emerald-300">
                  <code>{method.command}</code>
                </pre>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mx-auto mt-16 max-w-4xl rounded-2xl border border-cyan-500/20 bg-gradient-to-br from-cyan-500/10 to-emerald-500/5 p-8">
      <div class="flex flex-col items-start gap-5 sm:flex-row sm:items-center">
        <div class="rounded-2xl bg-cyan-500/10 p-3 text-cyan-400">
          <svg
            class="h-8 w-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            />
          </svg>
        </div>
        <div>
          <h4 class="text-lg font-bold text-white">Importante para Windows</h4>
          <p class="mt-2 text-slate-300">
            Después de instalar o cambiar de versión, ejecutá{' '}
            <code class="rounded-lg bg-slate-950 px-2 py-1 text-emerald-300">
              refreshenv
            </code>{' '}
            si tenés Chocolatey, o cerrá y volvé a abrir la terminal para que
            los cambios en el PATH se apliquen.
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.copy-btn').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = (button).dataset.code || '';
        await navigator.clipboard.writeText(code);
        const original = button.innerHTML;
        button.innerHTML = '<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Copiado';
        setTimeout(() => {
          button.innerHTML = original;
        }, 2000);
      });
    });
  </script>
</section>
