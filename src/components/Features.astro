---
const features = [
  {
    title: 'Descarga automática',
    description:
      'Soporta URLs directas o archivos locales .zip, .tar.gz y .tgz. Solo pasá el origen y switchtool hace el resto.',
    icon: 'download',
  },
  {
    title: 'PATH inteligente',
    description:
      'Limpia y actualiza el PATH de usuario mediante PowerShell sin que tengas que editar variables a mano.',
    icon: 'path',
  },
  {
    title: 'Variables de entorno',
    description:
      'Setea JAVA_HOME, MAVEN_HOME, GRADLE_HOME, PHP_HOME, GOROOT y NODE_HOME automáticamente.',
    icon: 'env',
  },
  {
    title: 'Detección de raíz',
    description:
      'Si el comprimido tiene una carpeta raíz extra, switchtool la detecta y entra en ella solito.',
    icon: 'folder',
  },
  {
    title: 'Cambio rápido',
    description:
      'Pasá de Java 17 a Java 21, o de Node 18 a Node 20, con un único comando: switchtool jdk21.',
    icon: 'switch',
  },
  {
    title: 'UI amigable',
    description:
      'Colores, barra de progreso, spinners y mensajes claros para que la experiencia sea agradable.',
    icon: 'ui',
  },
];

const icons: Record<string, string> = {
  download:
    'M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4',
  path: 'M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1',
  env: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  folder:
    'M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z',
  switch: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  ui: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01',
};
---

<section id="caracteristicas" class="py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base font-semibold leading-7 text-emerald-400">
        Características
      </h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Todo lo que necesitás para cambiar de versión sin fricción
      </p>
      <p class="mt-6 text-lg leading-8 text-slate-300">
        switchtool automatiza lo aburrido para que te enfoques en codear.
      </p>
    </div>

    <div
      class="mx-auto mt-16 grid max-w-7xl gap-8 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        features.map((feature) => (
          <div class="group relative rounded-2xl border border-slate-800 bg-slate-900/50 p-8 transition hover:border-emerald-500/30 hover:bg-slate-800/50">
            <div class="mb-5 inline-flex rounded-xl bg-emerald-500/10 p-3 text-emerald-400 ring-1 ring-emerald-500/20 transition group-hover:scale-110">
              <svg
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={icons[feature.icon]}
                />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white">{feature.title}</h3>
            <p class="mt-3 text-slate-400 leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
