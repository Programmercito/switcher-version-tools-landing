---
const lines = [
  { text: 'switchtool java jdk17 https://.../jdk17.zip', type: 'command' },
  { text: '✓ Descarga completada', type: 'success' },
  { text: '✓ Descompresión completada', type: 'success' },
  { text: 'Directorio principal detectado: C:\\Users\\dev\\.switchtool\\jdk17', type: 'info' },
  { text: '✓ Alias jdk17 agregado a la configuración.', type: 'success' },
  { text: 'switchtool jdk17', type: 'command' },
  { text: "Listo: ahora se está usando 'jdk17' para java.", type: 'success' },
];
---

<div
  class="glow-green mx-auto mt-20 max-w-3xl overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 shadow-2xl"
>
  <div
    class="flex items-center justify-between border-b border-slate-800 bg-gradient-to-r from-slate-900 to-slate-800 px-5 py-3"
  >
    <div class="flex items-center gap-2">
      <div class="h-3 w-3 rounded-full bg-red-500/80"></div>
      <div class="h-3 w-3 rounded-full bg-yellow-500/80"></div>
      <div class="h-3 w-3 rounded-full bg-green-500/80"></div>
    </div>
    <span class="text-xs font-medium text-slate-500">switchtool.exe</span>
  </div>
  <div class="code-block space-y-1.5 p-6 text-sm leading-relaxed">
    {
      lines.map((line) => {
        if (line.type === 'command') {
          return (
            <div class="flex items-start gap-2">
              <span class="select-none text-emerald-500">➜</span>
              <span class="font-medium text-slate-100">{line.text}</span>
            </div>
          );
        }
        if (line.type === 'success') {
          return <div class="pl-6 text-emerald-400">{line.text}</div>;
        }
        return <div class="pl-6 text-slate-400">{line.text}</div>;
      })
    }
    <div class="mt-3 flex items-start gap-2">
      <span class="select-none text-emerald-500">➜</span>
      <span class="inline-block h-5 w-2 animate-pulse rounded-sm bg-emerald-400"></span>
    </div>
  </div>
</div>
